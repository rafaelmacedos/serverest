{
  "scripts": {
    "cy:open:web": "cypress open",
    "cy:open:api": "cypress open --config-file cypress.api.config.js",
    "cy:run:web": "cypress run",
    "cy:run:api": "cypress run --config-file cypress.api.config.js",
    "test": "npm run cy:run:api && npm run cy:run:web",
    "cy:run:api:allure": "cypress run --config-file cypress.api.config.js --env allure=true",
    "cy:run:web:allure": "cypress run --env allure=true",
    "test:ci": "npm run cy:run:api:allure && npm run cy:run:web:allure",
    "test:report": "npm run test:ci; npm run allure:generate && npm run allure:open",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@shelex/cypress-allure-plugin": "^2.41.2",
    "allure-commandline": "^2.40.0",
    "cypress": "^15.14.2",
    "eslint": "^10.3.0",
    "eslint-plugin-cypress": "^6.4.1",
    "globals": "^17.6.0",
    "patch-package": "^8.0.1"
  },
  "dependencies": {
    "faker": "^5.5.3"
  }
}
